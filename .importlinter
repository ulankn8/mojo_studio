[importlinter]
root_package = toystudio
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    toystudio.app | toystudio.doctor
    toystudio.jobs
    toystudio.storage | toystudio.cloud | toystudio.engine
    toystudio.core

[importlinter:contract:core-pure]
name = core is pure (no Qt, sqlite, subprocess)
type = forbidden
source_modules =
    toystudio.core
forbidden_modules =
    PySide6
    sqlite3
    subprocess

[importlinter:contract:jobs-not-cloud]
name = jobs does not depend on cloud
type = forbidden
source_modules =
    toystudio.jobs
forbidden_modules =
    toystudio.cloud

[importlinter:contract:worker-no-qt]
name = worker-side jobs modules do not import Qt
type = forbidden
source_modules =
    toystudio.jobs.protocol
    toystudio.jobs.worker_main
forbidden_modules =
    PySide6

[importlinter:contract:engine-no-qt]
name = engine does not import Qt
type = forbidden
source_modules =
    toystudio.engine
forbidden_modules =
    PySide6
