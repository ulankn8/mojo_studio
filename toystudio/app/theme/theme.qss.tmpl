/* Template for tools/gen_theme.py; double-brace names are design tokens. */
QMainWindow, QWidget#Root {
    background: {{bg-000}};
}

QWidget {
    color: {{ink}};
    font-family: {{font-sans}};
}

QLabel {
    background: transparent;
}

QFrame#Panel {
    background: {{bg-100}};
}

QFrame#Card {
    background: {{bg-200}};
    border: 1px solid {{line-100}};
    border-radius: {{radius-lg}};
}

QWidget#TopBar {
    background: {{bg-100}};
    min-height: {{size-topbar}};
    max-height: {{size-topbar}};
}

QPushButton {
    background: {{bg-300}};
    color: {{ink}};
    border: 1px solid {{line-200}};
    border-radius: {{radius-md}};
    min-height: {{size-control}};
    padding: 0 {{space-4}};
    font-size: {{label-size}};
    font-weight: {{label-weight}};
}

QPushButton:hover {
    background: {{bg-400}};
}

QPushButton[variant="primary"] {
    background: {{garnet-500}};
    color: {{ink-on-accent}};
    border: none;
    min-height: {{size-control-lg}};
}

QPushButton[variant="primary"]:hover {
    background: {{garnet-600}};
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: none;
    color: {{ink-muted}};
}

QPushButton[variant="ghost"]:hover {
    background: {{bg-300}};
    color: {{ink}};
}

QPushButton[variant="ghost"]:checked {
    color: {{garnet-text}};
}

QPushButton[chip="true"] {
    background: {{bg-200}};
    border: 1px solid {{line-200}};
    border-radius: {{radius-pill}};
    padding: 0 {{space-3}};
}

QPushButton[chip="true"]:checked {
    background: {{garnet-tint}};
    border: 1px solid {{garnet-500}};
    color: {{garnet-text}};
}

/* Placed after every variant rule so the keyboard focus ring wins on equal specificity. */
QPushButton:focus,
QPushButton[variant="primary"]:focus,
QPushButton[variant="ghost"]:focus,
QPushButton[chip="true"]:focus {
    border: 2px solid {{focus}};
}

QLabel[badge] {
    border-radius: {{radius-pill}};
    padding: {{space-1}} {{space-2}};
    font-size: {{label-size}};
    font-weight: {{label-weight}};
}

QLabel[badge="analysis"] {
    background: {{teal-tint}};
    color: {{teal-400}};
}

QLabel[badge="ready"] {
    background: {{status-ready-tint}};
    color: {{status-ready}};
}

QLabel[badge="done"] {
    background: {{status-done-tint}};
    color: {{status-done}};
}

QLabel[badge="error"] {
    background: {{status-error-tint}};
    color: {{status-error}};
}

QLabel[badge="offline"] {
    background: {{bg-300}};
    color: {{status-offline}};
}

QLineEdit, QPlainTextEdit {
    background: {{bg-200}};
    color: {{ink}};
    border: 1px solid {{line-200}};
    border-radius: {{radius-md}};
    padding: {{space-2}} {{space-3}};
    selection-background-color: {{garnet-500}};
    selection-color: {{ink-on-accent}};
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 2px solid {{focus}};
}

/* Typography roles and tones for labels. */
QLabel[role="display"] { font-size: {{display-px}}; font-weight: {{display-wt}}; }
QLabel[role="title"] { font-size: {{title-px}}; font-weight: {{title-wt}}; }
QLabel[role="heading"] { font-size: {{heading-px}}; font-weight: {{heading-wt}}; }
QLabel[role="body"] { font-size: {{body-px}}; font-weight: {{body-wt}}; }
QLabel[role="label"] { font-size: {{label-px}}; font-weight: {{label-wt}}; }
QLabel[role="caption"] { font-size: {{caption-px}}; font-weight: {{caption-wt}}; }
QLabel[role="timecode"] {
    font-family: {{font-mono}};
    font-size: {{timecode-px}};
    font-weight: {{timecode-wt}};
}
QLabel[role="timecode-lg"] {
    font-family: {{font-mono}};
    font-size: {{timecode-lg-px}};
    font-weight: {{timecode-lg-wt}};
}
QLabel[tone="muted"] { color: {{ink-muted}}; }
QLabel[tone="faint"] { color: {{ink-faint}}; }
QLabel[tone="teal"] { color: {{teal-400}}; }
QLabel[tone="done"] { color: {{status-done}}; }
QLabel[tone="error"] { color: {{status-error}}; }

/* StatusBadge */
QFrame#StatusBadge {
    border-radius: {{radius-pill}};
}
QFrame#StatusBadge[badge="analysis"] { background: {{teal-tint}}; }
QFrame#StatusBadge[badge="ready"] { background: {{status-ready-tint}}; }
QFrame#StatusBadge[badge="done"] { background: {{status-done-tint}}; }
QFrame#StatusBadge[badge="error"] { background: {{status-error-tint}}; }
QFrame#StatusBadge[badge="offline"] { background: {{bg-300}}; }
QFrame#StatusBadge[badge="analysis"] QLabel { color: {{teal-400}}; }
QFrame#StatusBadge[badge="ready"] QLabel { color: {{status-ready}}; }
QFrame#StatusBadge[badge="done"] QLabel { color: {{status-done}}; }
QFrame#StatusBadge[badge="error"] QLabel { color: {{status-error}}; }
QFrame#StatusBadge[badge="offline"] QLabel { color: {{status-offline}}; }

/* Banner */
QFrame#Banner {
    border-radius: {{radius-md}};
    border: 1px solid {{line-100}};
}
QFrame#Banner[kind="error"] { background: {{status-error-tint}}; border-color: {{status-error}}; }
QFrame#Banner[kind="offline"] { background: {{bg-300}}; border-color: {{line-100}}; }
QFrame#Banner[kind="info"] { background: {{teal-tint}}; border-color: {{teal-400}}; }
QFrame#Banner QLabel { background: transparent; }

/* DropZone */
QFrame#DropZone {
    border: 2px dashed {{line-200}};
    border-radius: {{radius-lg}};
}
QFrame#DropZone[dragover="true"] {
    border: 2px solid {{garnet-500}};
    background: {{garnet-tint}};
}
QLabel#TrackTag {
    color: {{garnet-500}};
    font-weight: 600;
}
QScrollArea#TrackScroll, QWidget#TrackColumn { background: transparent; }
QFrame#DropRow { background: transparent; border-bottom: 1px solid {{line-100}}; }

/* ProjectCard */
QFrame#ProjectCard, QFrame#FormatCard {
    background: {{bg-200}};
    border: 1px solid {{line-100}};
    border-radius: {{radius-lg}};
}
QFrame#ProjectCard:hover, QFrame#FormatCard:hover { border: 1px solid {{line-200}}; }
QFrame#ProjectCard:focus { border: 2px solid {{focus}}; }
QLabel#ProjectPreview {
    background: {{player-bg}};
    border-top-left-radius: {{radius-lg}};
    border-top-right-radius: {{radius-lg}};
}
QProgressBar[bar="thin"] {
    background: {{bg-400}};
    border: none;
    max-height: {{space-1}};
    min-height: {{space-1}};
}
QProgressBar[bar="thin"]::chunk { background: {{teal-400}}; }

/* AnalysisStage */
QFrame#AnalysisStage { border-radius: {{radius-md}}; background: transparent; }
QFrame#AnalysisStage[state="running"] { background: {{teal-tint}}; }
QLabel#ProjectDuration {
    color: {{ink-on-accent}};
    background: {{scrim}};
    border-radius: {{radius-sm}};
    padding: 2px {{space-1}};
}

/* MomentCard */
QFrame#MomentCard {
    background: {{bg-200}};
    border: 1px solid {{line-100}};
    border-radius: {{radius-lg}};
}
QFrame#MomentCard[mark="must"] {
    background: {{garnet-tint}};
    border: 1px solid {{garnet-500}};
}
QLabel#MomentPreview {
    background: {{player-bg}};
    border-radius: {{radius-sm}};
}
QLabel#MomentTypeBadge {
    background: {{bg-300}};
    border-radius: {{radius-sm}};
    padding: 2px {{space-2}};
}
QLabel#MomentMark { color: {{ink-muted}}; }
QLabel#MomentMark[mark="must"] { color: {{gold-400}}; }
