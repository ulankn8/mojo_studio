/* Generated from design/tokens.json by tools/gen_theme.py. Do not edit. */
QMainWindow, QWidget#Root {
    background: #e9eaed;
}

QWidget {
    color: #1c1f24;
    font-family: Inter, "Segoe UI", system-ui, sans-serif;
}

QLabel {
    background: transparent;
}

QFrame#Panel {
    background: #f5f6f7;
}

QFrame#Card {
    background: #ffffff;
    border: 1px solid #e2e4e8;
    border-radius: 10px;
}

QWidget#TopBar {
    background: #f5f6f7;
    min-height: 48px;
    max-height: 48px;
}

QPushButton {
    background: #eef0f2;
    color: #1c1f24;
    border: 1px solid #8b919b;
    border-radius: 6px;
    min-height: 32px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background: #e2e5e9;
}

QPushButton[variant="primary"] {
    background: #a52a3a;
    color: #ffffff;
    border: none;
    min-height: 40px;
}

QPushButton[variant="primary"]:hover {
    background: #8a2230;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: none;
    color: #555c66;
}

QPushButton[variant="ghost"]:hover {
    background: #eef0f2;
    color: #1c1f24;
}

QPushButton[variant="ghost"]:checked {
    color: #a52a3a;
}

QPushButton[chip="true"] {
    background: #ffffff;
    border: 1px solid #8b919b;
    border-radius: 999px;
    padding: 0 12px;
}

QPushButton[chip="true"]:checked {
    background: #f8e4e7;
    border: 1px solid #a52a3a;
    color: #a52a3a;
}

/* Placed after every variant rule so the keyboard focus ring wins on equal specificity. */
QPushButton:focus,
QPushButton[variant="primary"]:focus,
QPushButton[variant="ghost"]:focus,
QPushButton[chip="true"]:focus {
    border: 2px solid #1f6f9e;
}

QLabel[badge] {
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 500;
}

QLabel[badge="analysis"] {
    background: #e1f0f8;
    color: #1f6f9e;
}

QLabel[badge="ready"] {
    background: #fbf1d9;
    color: #8a5d00;
}

QLabel[badge="done"] {
    background: #e0f2e7;
    color: #22794a;
}

QLabel[badge="error"] {
    background: #fbe6e2;
    color: #b23a2a;
}

QLabel[badge="offline"] {
    background: #eef0f2;
    color: #555c66;
}

QLineEdit, QPlainTextEdit {
    background: #ffffff;
    color: #1c1f24;
    border: 1px solid #8b919b;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #a52a3a;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #1f6f9e;
}

/* Typography roles and tones for labels. */
QLabel[role="display"] { font-size: 28px; font-weight: 600; }
QLabel[role="title"] { font-size: 20px; font-weight: 600; }
QLabel[role="heading"] { font-size: 15px; font-weight: 600; }
QLabel[role="body"] { font-size: 14px; font-weight: 400; }
QLabel[role="label"] { font-size: 13px; font-weight: 500; }
QLabel[role="caption"] { font-size: 12px; font-weight: 400; }
QLabel[role="timecode"] {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 500;
}
QLabel[role="timecode-lg"] {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 18px;
    font-weight: 500;
}
QLabel[tone="muted"] { color: #555c66; }
QLabel[tone="faint"] { color: #666d77; }
QLabel[tone="teal"] { color: #1f6f9e; }
QLabel[tone="done"] { color: #22794a; }
QLabel[tone="error"] { color: #b23a2a; }

/* StatusBadge */
QFrame#StatusBadge {
    border-radius: 999px;
}
QFrame#StatusBadge[badge="analysis"] { background: #e1f0f8; }
QFrame#StatusBadge[badge="ready"] { background: #fbf1d9; }
QFrame#StatusBadge[badge="done"] { background: #e0f2e7; }
QFrame#StatusBadge[badge="error"] { background: #fbe6e2; }
QFrame#StatusBadge[badge="offline"] { background: #eef0f2; }
QFrame#StatusBadge[badge="analysis"] QLabel { color: #1f6f9e; }
QFrame#StatusBadge[badge="ready"] QLabel { color: #8a5d00; }
QFrame#StatusBadge[badge="done"] QLabel { color: #22794a; }
QFrame#StatusBadge[badge="error"] QLabel { color: #b23a2a; }
QFrame#StatusBadge[badge="offline"] QLabel { color: #555c66; }

/* Banner */
QFrame#Banner {
    border-radius: 6px;
    border: 1px solid #e2e4e8;
}
QFrame#Banner[kind="error"] { background: #fbe6e2; border-color: #b23a2a; }
QFrame#Banner[kind="offline"] { background: #eef0f2; border-color: #e2e4e8; }
QFrame#Banner[kind="info"] { background: #e1f0f8; border-color: #1f6f9e; }
QFrame#Banner QLabel { background: transparent; }

/* DropZone */
QFrame#DropZone {
    border: 2px dashed #8b919b;
    border-radius: 10px;
}
QFrame#DropZone[dragover="true"] {
    border: 2px solid #a52a3a;
    background: #f8e4e7;
}
QLabel#TrackTag {
    color: #a52a3a;
    font-weight: 600;
}
QScrollArea#TrackScroll, QWidget#TrackColumn { background: transparent; }
QFrame#DropRow { background: transparent; border-bottom: 1px solid #e2e4e8; }

/* ProjectCard */
QFrame#ProjectCard, QFrame#FormatCard {
    background: #ffffff;
    border: 1px solid #e2e4e8;
    border-radius: 10px;
}
QFrame#ProjectCard:hover, QFrame#FormatCard:hover { border: 1px solid #8b919b; }
QFrame#ProjectCard:focus { border: 2px solid #1f6f9e; }
QLabel#ProjectPreview {
    background: #000000;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QProgressBar[bar="thin"] {
    background: #e2e5e9;
    border: none;
    max-height: 4px;
    min-height: 4px;
}
QProgressBar[bar="thin"]::chunk { background: #1f6f9e; }

/* AnalysisStage */
QFrame#AnalysisStage { border-radius: 6px; background: transparent; }
QFrame#AnalysisStage[state="running"] { background: #e1f0f8; }
QLabel#ProjectDuration {
    color: #ffffff;
    background: rgba(20,22,26,0.45);
    border-radius: 4px;
    padding: 2px 4px;
}

/* MomentCard */
QFrame#MomentCard {
    background: #ffffff;
    border: 1px solid #e2e4e8;
    border-radius: 10px;
}
QFrame#MomentCard[mark="must"] {
    background: #f8e4e7;
    border: 1px solid #a52a3a;
}
QLabel#MomentPreview {
    background: #000000;
    border-radius: 4px;
}
QLabel#MomentTypeBadge {
    background: #eef0f2;
    border-radius: 4px;
    padding: 2px 8px;
}
QLabel#MomentMark { color: #555c66; }
QLabel#MomentMark[mark="must"] { color: #8a5d00; }
