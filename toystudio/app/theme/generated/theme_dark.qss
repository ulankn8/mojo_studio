/* Generated from design/tokens.json by tools/gen_theme.py. Do not edit. */
QMainWindow, QWidget#Root {
    background: #0f1012;
}

QWidget {
    color: #eceef1;
    font-family: Inter, "Segoe UI", system-ui, sans-serif;
}

QLabel {
    background: transparent;
}

QFrame#Panel {
    background: #16181b;
}

QFrame#Card {
    background: #1e2125;
    border: 1px solid #2a2e34;
    border-radius: 10px;
}

QWidget#TopBar {
    background: #16181b;
    min-height: 48px;
    max-height: 48px;
}

QPushButton {
    background: #272b30;
    color: #eceef1;
    border: 1px solid #6b717b;
    border-radius: 6px;
    min-height: 32px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background: #32373d;
}

QPushButton[variant="primary"] {
    background: #b3303f;
    color: #ffffff;
    border: none;
    min-height: 40px;
}

QPushButton[variant="primary"]:hover {
    background: #962636;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: none;
    color: #a3a9b3;
}

QPushButton[variant="ghost"]:hover {
    background: #272b30;
    color: #eceef1;
}

QPushButton[variant="ghost"]:checked {
    color: #f2808c;
}

QPushButton[chip="true"] {
    background: #1e2125;
    border: 1px solid #6b717b;
    border-radius: 999px;
    padding: 0 12px;
}

QPushButton[chip="true"]:checked {
    background: #3a1a20;
    border: 1px solid #b3303f;
    color: #f2808c;
}

/* Placed after every variant rule so the keyboard focus ring wins on equal specificity. */
QPushButton:focus,
QPushButton[variant="primary"]:focus,
QPushButton[variant="ghost"]:focus,
QPushButton[chip="true"]:focus {
    border: 2px solid #5fb8e6;
}

QLabel[badge] {
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 500;
}

QLabel[badge="analysis"] {
    background: #15303d;
    color: #5fb8e6;
}

QLabel[badge="ready"] {
    background: #3a3018;
    color: #e8c063;
}

QLabel[badge="done"] {
    background: #17301f;
    color: #5cc98a;
}

QLabel[badge="error"] {
    background: #3a1d19;
    color: #f07a6a;
}

QLabel[badge="offline"] {
    background: #272b30;
    color: #a3a9b3;
}

QLineEdit, QPlainTextEdit {
    background: #1e2125;
    color: #eceef1;
    border: 1px solid #6b717b;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #b3303f;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #5fb8e6;
}

/* Typography roles and tones for labels. */
QLabel[role="display"] { font-size: 28px; font-weight: 600; }
QLabel[role="title"] { font-size: 20px; font-weight: 600; }
QLabel[role="heading"] { font-size: 15px; font-weight: 600; }
QLabel[role="body"] { font-size: 14px; font-weight: 400; }
QLabel[role="label"] { font-size: 13px; font-weight: 500; }
QLabel[role="caption"] { font-size: 12px; font-weight: 400; }
QLabel[role="timecode"] {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 500;
}
QLabel[role="timecode-lg"] {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 18px;
    font-weight: 500;
}
QLabel[tone="muted"] { color: #a3a9b3; }
QLabel[tone="faint"] { color: #8a909a; }
QLabel[tone="teal"] { color: #5fb8e6; }
QLabel[tone="done"] { color: #5cc98a; }
QLabel[tone="error"] { color: #f07a6a; }

/* StatusBadge */
QFrame#StatusBadge {
    border-radius: 999px;
}
QFrame#StatusBadge[badge="analysis"] { background: #15303d; }
QFrame#StatusBadge[badge="ready"] { background: #3a3018; }
QFrame#StatusBadge[badge="done"] { background: #17301f; }
QFrame#StatusBadge[badge="error"] { background: #3a1d19; }
QFrame#StatusBadge[badge="offline"] { background: #272b30; }
QFrame#StatusBadge[badge="analysis"] QLabel { color: #5fb8e6; }
QFrame#StatusBadge[badge="ready"] QLabel { color: #e8c063; }
QFrame#StatusBadge[badge="done"] QLabel { color: #5cc98a; }
QFrame#StatusBadge[badge="error"] QLabel { color: #f07a6a; }
QFrame#StatusBadge[badge="offline"] QLabel { color: #a3a9b3; }

/* Banner */
QFrame#Banner {
    border-radius: 6px;
    border: 1px solid #2a2e34;
}
QFrame#Banner[kind="error"] { background: #3a1d19; border-color: #f07a6a; }
QFrame#Banner[kind="offline"] { background: #272b30; border-color: #2a2e34; }
QFrame#Banner[kind="info"] { background: #15303d; border-color: #5fb8e6; }
QFrame#Banner QLabel { background: transparent; }

/* DropZone */
QFrame#DropZone {
    border: 2px dashed #6b717b;
    border-radius: 10px;
}
QFrame#DropZone[dragover="true"] {
    border: 2px solid #b3303f;
    background: #3a1a20;
}
QLabel#TrackTag {
    color: #b3303f;
    font-weight: 600;
}
QScrollArea#TrackScroll, QWidget#TrackColumn { background: transparent; }
QFrame#DropRow { background: transparent; border-bottom: 1px solid #2a2e34; }

/* ProjectCard */
QFrame#ProjectCard, QFrame#FormatCard {
    background: #1e2125;
    border: 1px solid #2a2e34;
    border-radius: 10px;
}
QFrame#ProjectCard:hover, QFrame#FormatCard:hover { border: 1px solid #6b717b; }
QFrame#ProjectCard:focus { border: 2px solid #5fb8e6; }
QLabel#ProjectPreview {
    background: #000000;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QProgressBar[bar="thin"] {
    background: #32373d;
    border: none;
    max-height: 4px;
    min-height: 4px;
}
QProgressBar[bar="thin"]::chunk { background: #5fb8e6; }

/* AnalysisStage */
QFrame#AnalysisStage { border-radius: 6px; background: transparent; }
QFrame#AnalysisStage[state="running"] { background: #15303d; }
QLabel#ProjectDuration {
    color: #ffffff;
    background: rgba(0,0,0,0.6);
    border-radius: 4px;
    padding: 2px 4px;
}

/* MomentCard */
QFrame#MomentCard {
    background: #1e2125;
    border: 1px solid #2a2e34;
    border-radius: 10px;
}
QFrame#MomentCard[mark="must"] {
    background: #3a1a20;
    border: 1px solid #b3303f;
}
QLabel#MomentPreview {
    background: #000000;
    border-radius: 4px;
}
QLabel#MomentTypeBadge {
    background: #272b30;
    border-radius: 4px;
    padding: 2px 8px;
}
QLabel#MomentMark { color: #a3a9b3; }
QLabel#MomentMark[mark="must"] { color: #e8c063; }
